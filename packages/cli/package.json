  "repository": { "type": "git", "url": "git+https://github.com/Shreyastacky/row-proof.git", "directory": "packages/cli" },
  "bugs": "https://github.com/Shreyastacky/row-proof/issues",
  "type": "module",
  "bin": { "rowproof": "./dist/rowproof.mjs" },
  "files": ["dist", "schemas", "README.md", "LICENSE.md"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node build.mjs",
