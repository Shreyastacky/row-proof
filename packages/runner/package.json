{
  "name": "@rowproof/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-run RowProof CLI: approval workflow and bounded read-isolation assertions.",
  "type": "module",
  "bin": {
    "rowproof": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rowproof/contracts": "workspace:*",
    "@rowproof/local-fixture": "workspace:*"
  }
}
